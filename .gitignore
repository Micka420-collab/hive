# Sans la barre finale : « node_modules/ » ne vise qu'un dossier, et laisse
# passer un LIEN nommé node_modules — c'est ainsi qu'un lien absolu vers
# /home/user/hive/node_modules s'est retrouvé suivi sur une branche.
node_modules
dist/
dashboard/dist/
data/
.hive-work/
coverage/
.env
*.db
*.db-journal
*.db-wal
*.db-shm
*.tsbuildinfo
.hermes/
.claude/

# Le rapport JSON de vitest, produit par la CI pour le garde-badge.
rapport-tests.json

# Le verrou d’exclusivité de la loupe — propre à une exécution, jamais partagé.
.loupe-verrou
# Le journal de reprise de la loupe : il porte l’ORIGINAL d’un fichier en cours
# de mutation, pour qu’un balayage tué ne laisse pas son défaut dans l’arbre.
# Propre à une exécution, jamais partagé.
.loupe-en-cours

# Les captures d'écran de `npm run captures` — refaites en une commande, sur
# l'arbre courant. Celles qu'on publie sont COPIÉES exprès sous docs/images.
captures-ecran/

# L'application de bureau (desktop/) : ce qui se reconstruit en une commande.
# `desktop/build/installer.nsh` et `desktop/branding/*/sorties/` sont versionnés.
desktop/dist/
desktop/marque/
desktop/build/hive/
desktop/release/
