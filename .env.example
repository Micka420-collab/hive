# ─── Orchestrateur (Queen) ───────────────────────────────────────────────────
# Port HTTP + WebSocket de l'orchestrateur (le dashboard est servi sur ce port)
HIVE_PORT=7777
# Adresse d'écoute (127.0.0.1 par défaut ; 0.0.0.0 pour accepter des nœuds distants)
HIVE_HOST=127.0.0.1

# Jeton partagé entre l'orchestrateur et les nœuds.
# OBLIGATOIREMENT non-trivial (>= 16 caractères) hors mode simulation.
# Générer par ex. : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HIVE_TOKEN=change-me

# ─── Connecter ses depots GitHub ─────────────────────────────────────────────
# Jeton GitHub, pour lister vos depots et en connecter un a la ruche :
#   npm run cli -- github            liste vos depots, choix par NUMERO
#   npm run cli -- github-import owner/repo
#
# Creez-le sur https://github.com/settings/tokens (portee « repo » pour voir
# vos depots prives).
#
# CE JETON N'EST JAMAIS ECRIT EN BASE. Il est lu ici au demarrage et vit en
# memoire, le temps du processus. Une base volee ne donne donc pas acces a vos
# depots — et le retirer, c'est redemarrer l'orchestrateur.
#
# Seul HIVE_GITHUB_TOKEN est lu : pas de repli sur GITHUB_TOKEN, qui traine
# dans trop d'environnements pour qu'on l'utilise sans que vous l'ayez voulu.
# HIVE_GITHUB_TOKEN=ghp_...
# HIVE_GITHUB_API=https://git.interne.example/api/v3   # GitHub Enterprise

# ─── Le trou de vol ──────────────────────────────────────────────────────────
# HIVE_TOKEN ci-dessus est la CLÉ MAÎTRESSE : elle ouvre tout, pour toujours, et
# ne peut être révoquée que pour tout le monde à la fois. Ne la partagez plus.
#
# Pour connecter quelqu'un, émettez un BILLET — éphémère, à usage compté,
# révocable individuellement :
#
#   npm run cli -- invite                     billet sur le réseau local
#   npm run cli -- tunnel                     accès distant chiffré (wss://), sans ouvrir de port
#   npm run cli -- invite --uses 3 --hours 2  3 machines, valable 2 h
#   npm run cli -- membres                    qui a les clés, quels billets circulent
#   npm run cli -- exclure <nodeId>           couper UNE personne, tout de suite


# Origine(s) autorisée(s) pour le CORS — JAMAIS "*".
# En production : l'origine exacte du dashboard. Plusieurs origines séparées par des virgules.
HIVE_CORS_ORIGIN=http://localhost:5173

# Chemin du fichier SQLite (persistance de l'état)
HIVE_DB=./data/hive.db

# 1 = mode simulation/démo : tolère le token par défaut, adaptateur shell simulé.
HIVE_SIMULATION=0

# La Balance (le pèse-ruche) : off | observation | strict. Défaut « observation ».
#   off         : le grand livre ne tourne pas ; /api/balance rend des soldes vides.
#   observation : la ruche pèse ce qu'elle dépense et l'expose ; elle ne bloque RIEN.
#   strict      : au plafond, la ruche cesse d'assigner de NOUVELLES tâches du
#                 projet concerné. Les tâches en vol vont à leur terme, les
#                 autres projets continuent, et le déblocage est un geste humain
#                 explicite (PUT /api/projects/:id/balance).
# Le blocage est DOUBLEMENT opt-in : sans plafond posé à la main sur un projet,
# « strict » est rigoureusement indiscernable d'« observation ».
# ⚠ Un plafond n'est PAS une frontière de sécurité : durationMs est déclaré par
# l'agent (voir la section Sécurité du README).
# Toute autre valeur retombe sur « observation » : une faute de frappe ne doit
# jamais éteindre silencieusement la pesée.
# HIVE_BALANCE=observation

# Les Gardiennes (le contrôle d'entrée du nectar) : off | consultatif | strict.
# Défaut « consultatif ».
# Au trou de vol, les gardiennes reniflent chaque butineuse de retour : une
# production qui déclare « succès » avec un diff vide (ou un diff qui ne touche
# aucun fichier promis, ou des logs qui crient l'échec) n'entre pas dans le rayon
# sur la seule parole de l'ouvrière.
#   off         : aucune inspection, aucune écriture ; la ruche est
#                 indiscernable de celle d'avant les Gardiennes.
#   consultatif : chaque production réussie est reniflée et son verdict RANGÉ,
#                 mais RIEN n'est refusé et aucun événement n'est émis. On
#                 observe et on annote — la campagne se lit sur /api/gardiennes.
#   strict      : une production jugée creuse ne franchit pas le trou de vol.
#                 Elle ne nourrit ni le Hive Mind, ni les phéromones, ni le
#                 nectar, ni « utile » dans La Balance, et la tâche RE-TENTE sur
#                 le budget de tentatives EXISTANT (MAX_ATTEMPTS = 3) — jamais
#                 sur un compteur à part, donc jamais sans fin.
# Le défaut est délibérément non contraignant : un faux positif brûlerait une
# tentative légitime, ce qui est pire que le mal qu'on soigne. Comme pour
# HIVE_BALANCE, toute autre valeur retombe sur le défaut — une faute de frappe
# ne doit jamais pouvoir fermer le trou de vol.
# ⚠ Les Gardiennes ne mergent rien et n'approuvent rien : elles refusent
# l'entrée, la revue humaine (la Miellerie) reste entière.
# HIVE_GARDIENNES=consultatif

# URL WebSocket publique annoncée dans les invitations (« Inviter un ami »).
# Laisser vide → l'IP du réseau local est détectée automatiquement.
# Pour un accès distant : wss://mondomaine:7777/ws
# HIVE_PUBLIC_URL=

# Secret de signature des sessions utilisateur (JWT — /api/auth/*).
# À définir en production : sans lui, un secret de développement est utilisé.
# Générer par ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HIVE_JWT_SECRET=

# ─── Queen Bee — planner IA (Palier 2) ───────────────────────────────────────
# POST /api/plan découpe un brief en DAG de tâches. Par défaut : découpage
# HEURISTIQUE hors-ligne (aucune clé requise). Si une clé Anthropic est présente
# ci-dessous, le planner passe en mode IA (repli automatique sur l'heuristique en
# cas d'échec). La clé reste locale à l'orchestrateur, jamais transmise ailleurs.
# ANTHROPIC_API_KEY=
# Modèle du planner (défaut : rapide et économique). Ex. claude-opus-4-8 pour + de finesse.
# HIVE_PLANNER_MODEL=claude-haiku-4-5

# ─── La Reine répond (chat multilingue, POST /api/chat) ─────────────────────
# Sans clé : réponses « état réel » (hors-ligne, déterministes). Avec la clé
# Anthropic ci-dessus : réponses rédigées par l'IA dans la langue du message.
# Modèle du chat (défaut : rapide et économique).
# HIVE_CHAT_MODEL=claude-haiku-4-5

# ─── Queen Bee via OpenRouter (POST /api/projects/:id/brief) ─────────────────
# Second backend de découpage de brief (complémentaire de /api/plan ci-dessus).
# QUEEN_BEE_API_KEY=            # ou OPENROUTER_API_KEY
# QUEEN_BEE_MODEL=
# QUEEN_BEE_LANGUAGE=français

# ─── Nœud membre (Node) ──────────────────────────────────────────────────────
# URL WebSocket de l'orchestrateur à rejoindre
HIVE_URL=ws://localhost:7777/ws
# Identité du nœud
HIVE_NODE_NAME=ma-machine
HIVE_OWNER_NAME=moi
# Adaptateur d'agent : shell | claude-code | codex | hermes-agent | custom
HIVE_AGENT=shell
# Adaptateur « custom » : commande libre, {prompt} remplacé par la consigne.
# HIVE_AGENT_CMD=aider --yes --message {prompt}
# Adaptateur « hermes-agent » : chemin/modèle du binaire Hermes.
# HERMES_PATH=hermes
# HERMES_MODEL=

# Night Shift : heures de SERVICE du nœud (heure locale de la machine).
# Hors fenêtre, le nœud refuse poliment les tâches (aucune tentative brûlée).
# Fenêtres séparées par des virgules, passage minuit géré. Vide = 24h/24.
# HIVE_SHIFT=22-8,13:30-14
# Nombre max de tâches en parallèle sur ce nœud
HIVE_MAX_CONCURRENCY=2
# Répertoire de travail des tâches (sandbox v0 — un cwd isolé par tâche)
HIVE_WORKDIR=./.hive-work

# 1 = autorise l'adaptateur shell à exécuter de VRAIES commandes (spawn shell:false).
# REFUSÉ si HIVE_TOKEN est resté à sa valeur par défaut.
HIVE_REAL_SHELL=0

# Variables d'environnement supplémentaires transmises à l'agent dans la sandbox
# (séparées par des virgules). Un agent réel (claude-code/codex) reçoit DÉJÀ
# automatiquement sa config (HOME/APPDATA…) et sa clé API (ANTHROPIC_API_KEY /
# OPENAI_API_KEY) ; n'ajoutez ici que d'éventuelles variables en plus.
# HIVE_KEEP_ENV=MA_VARIABLE,AUTRE_VARIABLE
