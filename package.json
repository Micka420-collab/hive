{
  "name": "hive",
  "version": "0.1.0",
  "private": true,
  "description": "Hive — plateforme communautaire d'orchestration d'agents IA (hub-and-spoke). Palier 1 : essaim réel, visible et persistant.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/orchestrator/main.ts",
    "node": "tsx src/node-client/main.ts",
    "join": "tsx src/node-client/join.ts",
    "demo": "tsx src/demo.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json",
    "build": "npm run typecheck && npm run typecheck:dashboard && npm run build:dashboard",
    "build:dashboard": "vite build dashboard",
    "dev:dashboard": "vite dashboard",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@galacean/engine": "^1.6.13",
    "@galacean/engine-toolkit-controls": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-git": "^3.36.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
