{
  "name": "hive",
  "version": "0.3.0",
  "private": true,
  "description": "Hive — plateforme communautaire d'orchestration d'agents IA (hub-and-spoke). Palier 1 : essaim réel, visible et persistant.",
  "bin": {
    "hive": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    ".env.example"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/orchestrator/main.ts",
    "node": "node scripts/lancer.mjs src/node-client/main.ts",
    "join": "node scripts/lancer.mjs src/node-client/join.ts",
    "demo": "node scripts/lancer.mjs src/demo.ts",
    "cli": "node scripts/lancer.mjs src/cli.ts",
    "install:hive": "node scripts/lancer.mjs src/installer-main.ts",
    "setup": "npm install && npm run install:hive",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json",
    "build": "npm run typecheck && npm run typecheck:dashboard && npm run build:node && npm run build:dashboard",
    "build:dashboard": "vite build dashboard",
    "dev:dashboard": "vite dashboard",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "loupe": "node scripts/loupe.mjs",
    "tamis-ordres": "node scripts/tamis-ordres.mjs",
    "compte-tests": "node scripts/compte-tests.mjs rapport-tests.json",
    "couverture": "vitest run --coverage",
    "fusionner": "sh scripts/fusionner.sh",
    "ruche": "node scripts/ruche.mjs",
    "format": "prettier --write .",
    "build:node": "tsc -p tsconfig.build.json",
    "prepare": "npm run build:node"
  },
  "dependencies": {
    "simple-git": "^3.36.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@eslint/js": "^10.0.1",
    "@galacean/engine": "^1.6.13",
    "@galacean/engine-toolkit-controls": "^1.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "codemirror": "^6.0.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
